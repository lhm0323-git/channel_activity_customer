rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'lhm0323@gmail.com'; }
    function isStaff() {
      return isAdmin() || (
        signedIn() && request.auth.token.email is string &&
        exists(/databases/$(database)/documents/staffUsers/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/staffUsers/$(request.auth.token.email.lower())).data.active != false
      );
    }
    function ownsResource() { return signedIn() && resource.data.ownerUid == request.auth.uid; }

    match /customers/{customerId} {
      allow read: if isStaff() || ownsResource();
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /bookings/{bookingId} {
      allow read: if isStaff() || ownsResource();
      allow update: if isStaff();
      allow create, delete: if false;
    }
    match /bookingBlockedDates/{date} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }
    match /bookingChangeRequests/{requestId} {
      allow read, update: if isStaff();
      allow create, delete: if false;
    }
    match /checklists/{bookingId} {
      allow read, create, update: if isStaff();
      allow delete: if false;
    }
    match /managedPackages/{packageId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /managedItems/{itemId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /staffUsers/{email} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /packageQuestionnaireRules/{packageId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /customerQuestionnaireResponses/{responseId} {
      allow read: if isStaff() || ownsResource();
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /managedQuestionnaires/{qId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /settings/{settingId} {
      allow read: if isStaff() || settingId == 'publicAddonCategories';
      allow create, update: if isStaff();
      allow delete: if false;
    }
  }
}