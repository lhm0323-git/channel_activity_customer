rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasAuthClaim(name) {
      return signedIn() && request.auth.token.keys().hasAll([name]);
    }
    function staffKey() {
      return hasAuthClaim('staffKey') && request.auth.token.staffKey is string ? request.auth.token.staffKey :
        (hasAuthClaim('email') && request.auth.token.email is string ? request.auth.token.email.lower() : '');
    }
    function hasStaffRecord() {
      return signedIn() && staffKey() != '' &&
        exists(/databases/$(database)/documents/staffUsers/$(staffKey())) &&
        get(/databases/$(database)/documents/staffUsers/$(staffKey())).data.active != false;
    }
    function isBootstrapAdmin() {
      return hasAuthClaim('email') && request.auth.token.email == 'lhm0323@gmail.com';
    }
    function isAdmin() {
      return isBootstrapAdmin() ||
        (hasStaffRecord() && get(/databases/$(database)/documents/staffUsers/$(staffKey())).data.role == 'ADMIN');
    }    function isStaff() { return isAdmin() || hasStaffRecord(); }
    function ownsResource() { return signedIn() && resource.data.ownerUid == request.auth.uid; }

    match /customers/{customerId} {
      allow read: if isStaff() || ownsResource();
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /bookings/{bookingId} {
      allow read: if isStaff() || ownsResource();
      allow create, update, delete: if false;
    }
    match /bookingClaims/{claimToken} {
      allow read, write: if false;
    }
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /bookingBlockedDates/{date} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }
    match /bookingChangeRequests/{requestId} {
      allow read, update: if isStaff();
      allow create, delete: if false;
    }
    match /checklists/{bookingId} {
      allow read, create, update: if isStaff();
      allow delete: if false;
    }
    match /managedPackages/{packageId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /packageInvites/{token} {
      allow read, create, update, delete: if false;
    }
    match /managedItems/{itemId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /staffUsers/{email} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /packageQuestionnaireRules/{packageId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /customerQuestionnaireResponses/{responseId} {
      allow read: if isStaff() || ownsResource();
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /managedQuestionnaires/{qId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /settings/{settingId} {
      allow read: if isStaff() || settingId == 'publicAddonCategories';
      allow create, update: if isStaff();
      allow delete: if false;
    }
  }
}